{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trolley",
  "version": "0.3.2",
  "identifier": "io.trolley.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trolley",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'",
          "customprotocol:",
          "asset:"
        ],
        "connect-src": [
          "ipc:",
          "http://ipc.localhost"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "data:",
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "script-src": [
          "'self'"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Plan one project through four synchronized views",
    "longDescription": "Four synchronized ways to plan local projects.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/Trolley-GPL-3.0.txt",
      "../licenses/Manrope-OFL.txt": "licenses/Manrope-OFL.txt",
      "../NOTICE": "licenses/Trolley-NOTICE.txt",
      "vendor/glib/LICENSE": "licenses/GLib-MIT.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
