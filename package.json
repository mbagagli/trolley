{
  "name": "trolley",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "tsc -b --pretty false && vitest run && npm run test:version",
    "test:version": "node scripts/set-version.test.mjs",
    "test:drag": "node scripts/drag-qa.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "tauri": "node scripts/tauri.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "vite preview --config website/vite.config.mjs",
    "test:site": "node --test scripts/site.test.mjs",
    "test:release": "node --test scripts/check-release-tag.test.mjs scripts/tauri.test.mjs",
    "security:rust": "node scripts/security-audit.mjs",
    "test:security": "node --test scripts/security-audit.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "lucide-react": "^0.541.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.5"
  },
  "license": "GPL-3.0-or-later"
}
